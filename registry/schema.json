{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siesta-ai-protocol.github.io/siesta-protocol/registry/schema.json",
  "title": "Siesta Supported Libraries Registry",
  "description": "JSON Schema for registry/libraries.yaml (parsed as JSON-compatible YAML).",
  "type": "object",
  "required": ["libraries"],
  "additionalProperties": false,
  "properties": {
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/libraryEntry" }
    }
  },
  "definitions": {
    "libraryEntry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "language",
        "package",
        "repository",
        "manifest",
        "siestaVersion",
        "status",
        "maintainer"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable library id matching manifest.library"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable display name"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": ["PHP", "TypeScript", "JavaScript", "Python", "Go", "Ruby", "Java", "Other"]
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "description": "Package manager identifier (e.g. Composer/npm name)"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "Public source repository URL"
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "description": "Path to siesta.manifest.json within the repository"
        },
        "siestaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "status": {
          "type": "string",
          "enum": ["official", "community", "experimental"]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maintainer": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub org or user responsible for the listing"
        },
        "added": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date the library was listed"
        }
      }
    }
  }
}
